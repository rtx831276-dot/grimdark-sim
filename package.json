{
  "name": "grimdark-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simulateur de guerre tactique isométrique 2.5D grimdark — prototype V0 (simulation pure, rendu Canvas 2D)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "headless": "tsx scripts/headless-battle.ts",
    "map:inspect": "tsx scripts/inspect-map.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "build:offline": "npm run build && node scripts/build-offline.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  }
}
